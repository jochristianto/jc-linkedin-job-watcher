{
  "type": "module",
  "scripts": {
    "sandcastle": "npm run sandcastle:preflight && npx tsx .sandcastle/main.mts",
    "sandcastle:preflight": "npx tsx .sandcastle/preflight.mts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:dev": "vite build --mode prefill && vite build --config vite.content.config.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"mockups/**/*.test.ts\"",
    "send-test-message": "node --env-file-if-exists=.env --experimental-strip-types scripts/send-test-message.ts",
    "build:mockups": "tsx scripts/build-mockups.tsx"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/node": "22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
