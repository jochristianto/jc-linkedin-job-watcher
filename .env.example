# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
#
# SCOPE: this file configures ONE dev script — `npm run send-test-message`, which
# sends a test Telegram push from the terminal so you can check how the message
# looks on your phone without waiting for a scan.
#
# The extension itself reads NOTHING from here. It is a client-side bundle, so a
# build-time secret would be inlined into dist/ in plain text for anyone to read.
# The Telegram token the extension actually uses at runtime is the one you type
# into Options -> Telegram push; it lives in chrome.storage.local, in your Chrome
# profile only, and can be changed without rebuilding.

# From @BotFather on Telegram: send /newbot and follow the prompts.
TELEGRAM_BOT_TOKEN=

# Message your bot once, then open
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and read result[0].message.chat.id out of the JSON.
TELEGRAM_CHAT_ID=
